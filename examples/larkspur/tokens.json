{
  "$description": "Design tokens for the Larkspur example (a made-up product): primitives, light and dark roles, and the text pairs that are measured.",
  "primitive": {
    "color": {
      "$type": "color",
      "paper-50": {
        "$value": "#f6f1e7"
      },
      "paper-200": {
        "$value": "#ebe3d3"
      },
      "paper-400": {
        "$value": "#cfc3aa"
      },
      "ink-900": {
        "$value": "#1d2433"
      },
      "ink-600": {
        "$value": "#4a5163"
      },
      "violet-700": {
        "$value": "#4b3fbf"
      },
      "violet-100": {
        "$value": "#e4e0fa"
      },
      "violet-300": {
        "$value": "#b9b0ff"
      },
      "night-950": {
        "$value": "#11151f"
      },
      "night-900": {
        "$value": "#1b2130"
      },
      "night-700": {
        "$value": "#3a4360"
      },
      "mist-100": {
        "$value": "#e6e9f2"
      },
      "mist-300": {
        "$value": "#aab2c8"
      },
      "mist-500": {
        "$value": "#8590ad"
      }
    },
    "space": {
      "$type": "dimension",
      "1": {
        "$value": "4px"
      },
      "2": {
        "$value": "8px"
      },
      "3": {
        "$value": "12px"
      },
      "4": {
        "$value": "16px"
      },
      "5": {
        "$value": "24px"
      },
      "6": {
        "$value": "32px"
      },
      "7": {
        "$value": "48px"
      },
      "8": {
        "$value": "64px"
      },
      "9": {
        "$value": "96px"
      }
    },
    "gutter": {
      "$type": "dimension",
      "phone": {
        "$value": "16px"
      },
      "wide": {
        "$value": "32px"
      }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "text": {
          "$value": [
            "system-ui",
            "-apple-system",
            "Segoe UI",
            "sans-serif"
          ]
        },
        "display": {
          "$value": [
            "Georgia",
            "Times New Roman",
            "serif"
          ]
        }
      },
      "size": {
        "$type": "dimension",
        "caption": {
          "$value": "clamp(0.833rem, 0.8rem + 0.15vw, 0.9rem)"
        },
        "body": {
          "$value": "clamp(1rem, 0.95rem + 0.25vw, 1.125rem)"
        },
        "section": {
          "$value": "clamp(1.44rem, 1.3rem + 0.7vw, 1.8rem)"
        },
        "page": {
          "$value": "clamp(2rem, 1.5rem + 2.5vw, 3.2rem)"
        },
        "display": {
          "$value": "clamp(2.6rem, 1.8rem + 4vw, 5rem)"
        }
      },
      "leading": {
        "$type": "number",
        "body": {
          "$value": 1.5
        },
        "heading": {
          "$value": 1.2
        },
        "display": {
          "$value": 1.05
        }
      }
    },
    "radius": {
      "$type": "dimension",
      "control": {
        "$value": "10px"
      },
      "card": {
        "$value": "16px"
      }
    },
    "motion": {
      "duration": {
        "$type": "duration",
        "press": {
          "$value": "100ms"
        },
        "ui": {
          "$value": "250ms"
        },
        "hero": {
          "$value": "900ms"
        }
      },
      "ease": {
        "$type": "cubicBezier",
        "out": {
          "$value": [
            0.2,
            0.8,
            0.2,
            1
          ]
        }
      }
    },
    "measure": {
      "$type": "dimension",
      "prose": {
        "$value": "50ch"
      }
    }
  },
  "semantic": {
    "light": {
      "color": {
        "$type": "color",
        "canvas": {
          "$value": "{primitive.color.paper-50}"
        },
        "surface": {
          "$value": "{primitive.color.paper-200}"
        },
        "text": {
          "$value": "{primitive.color.ink-900}"
        },
        "text-quiet": {
          "$value": "{primitive.color.ink-600}"
        },
        "action": {
          "$value": "{primitive.color.violet-700}"
        },
        "on-action": {
          "$value": "{primitive.color.paper-50}"
        },
        "tint": {
          "$value": "{primitive.color.violet-100}"
        },
        "border": {
          "$value": "{primitive.color.ink-600}"
        },
        "rule": {
          "$value": "{primitive.color.paper-400}"
        },
        "focus": {
          "$value": "{primitive.color.violet-700}"
        }
      }
    },
    "dark": {
      "color": {
        "$type": "color",
        "canvas": {
          "$value": "{primitive.color.night-950}"
        },
        "surface": {
          "$value": "{primitive.color.night-900}"
        },
        "text": {
          "$value": "{primitive.color.mist-100}"
        },
        "text-quiet": {
          "$value": "{primitive.color.mist-300}"
        },
        "action": {
          "$value": "{primitive.color.violet-300}"
        },
        "on-action": {
          "$value": "{primitive.color.night-950}"
        },
        "tint": {
          "$value": "{primitive.color.night-700}"
        },
        "border": {
          "$value": "{primitive.color.mist-500}"
        },
        "rule": {
          "$value": "{primitive.color.night-700}"
        },
        "focus": {
          "$value": "{primitive.color.violet-300}"
        }
      }
    }
  },
  "$extensions": {
    "brief2motion": {
      "pairs": [
        {
          "fg": "color.text",
          "bg": "color.canvas",
          "kind": "text"
        },
        {
          "fg": "color.text",
          "bg": "color.surface",
          "kind": "text"
        },
        {
          "fg": "color.text-quiet",
          "bg": "color.canvas",
          "kind": "text"
        },
        {
          "fg": "color.text-quiet",
          "bg": "color.surface",
          "kind": "text"
        },
        {
          "fg": "color.on-action",
          "bg": "color.action",
          "kind": "text"
        },
        {
          "fg": "color.action",
          "bg": "color.canvas",
          "kind": "ui"
        },
        {
          "fg": "color.action",
          "bg": "color.surface",
          "kind": "ui"
        },
        {
          "fg": "color.border",
          "bg": "color.canvas",
          "kind": "ui"
        },
        {
          "fg": "color.text",
          "bg": "color.tint",
          "kind": "text"
        },
        {
          "fg": "color.focus",
          "bg": "color.canvas",
          "kind": "ui"
        }
      ]
    }
  }
}
