{
  "$description": "Design tokens for the Tidepool Open Day example: primitives, light and dark roles, and the text pairs that are measured.",
  "primitive": {
    "color": {
      "$type": "color",
      "sand-50": { "$value": "#fbf6ec" },
      "sand-200": { "$value": "#efe4cf" },
      "navy-900": { "$value": "#14233a" },
      "navy-600": { "$value": "#3b4f6e" },
      "navy-950": { "$value": "#0d1726" },
      "coral-700": { "$value": "#b3412a" },
      "coral-300": { "$value": "#ff9a80" },
      "foam-100": { "$value": "#e9eef7" },
      "foam-300": { "$value": "#aebcd4" }
    },
    "space": {
      "$type": "dimension",
      "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" }, "4": { "$value": "16px" }, "5": { "$value": "24px" },
      "6": { "$value": "32px" }, "7": { "$value": "48px" }, "8": { "$value": "64px" }, "9": { "$value": "96px" }
    },
    "gutter": { "$type": "dimension", "phone": { "$value": "16px" }, "wide": { "$value": "32px" } },
    "font": {
      "family": { "$type": "fontFamily", "text": { "$value": ["system-ui", "-apple-system", "Segoe UI", "sans-serif"] }, "display": { "$value": ["Georgia", "Times New Roman", "serif"] } },
      "size": {
        "$type": "dimension",
        "caption": { "$value": "clamp(0.833rem, 0.8rem + 0.15vw, 0.9rem)" },
        "body": { "$value": "clamp(1rem, 0.95rem + 0.25vw, 1.125rem)" },
        "section": { "$value": "clamp(1.44rem, 1.3rem + 0.7vw, 1.8rem)" },
        "page": { "$value": "clamp(2rem, 1.5rem + 2.5vw, 3.2rem)" },
        "display": { "$value": "clamp(2.6rem, 1.8rem + 4vw, 5rem)" }
      },
      "leading": { "$type": "number", "body": { "$value": 1.5 }, "heading": { "$value": 1.2 }, "display": { "$value": 1.05 } }
    },
    "measure": { "$type": "dimension", "prose": { "$value": "50ch" } },
    "radius": { "$type": "dimension", "control": { "$value": "10px" }, "card": { "$value": "16px" } },
    "motion": {
      "duration": { "$type": "duration", "press": { "$value": "100ms" }, "ui": { "$value": "250ms" }, "hero": { "$value": "900ms" } },
      "ease": { "$type": "cubicBezier", "out": { "$value": [0.2, 0.8, 0.2, 1] } }
    }
  },
  "semantic": {
    "light": {
      "color": {
        "$type": "color",
        "canvas": { "$value": "{primitive.color.sand-50}" },
        "surface": { "$value": "{primitive.color.sand-200}" },
        "text": { "$value": "{primitive.color.navy-900}" },
        "text-quiet": { "$value": "{primitive.color.navy-600}" },
        "action": { "$value": "{primitive.color.coral-700}" },
        "on-action": { "$value": "{primitive.color.sand-50}" },
        "focus": { "$value": "{primitive.color.navy-900}" }
      }
    },
    "dark": {
      "color": {
        "$type": "color",
        "canvas": { "$value": "{primitive.color.navy-950}" },
        "surface": { "$value": "{primitive.color.navy-900}" },
        "text": { "$value": "{primitive.color.foam-100}" },
        "text-quiet": { "$value": "{primitive.color.foam-300}" },
        "action": { "$value": "{primitive.color.coral-300}" },
        "on-action": { "$value": "{primitive.color.navy-950}" },
        "focus": { "$value": "{primitive.color.foam-100}" }
      }
    }
  },
  "$extensions": {
    "brief2motion": {
      "pairs": [
        { "fg": "color.text", "bg": "color.canvas", "kind": "text" },
        { "fg": "color.text", "bg": "color.surface", "kind": "text" },
        { "fg": "color.text-quiet", "bg": "color.canvas", "kind": "text" },
        { "fg": "color.text-quiet", "bg": "color.surface", "kind": "text" },
        { "fg": "color.on-action", "bg": "color.action", "kind": "text" },
        { "fg": "color.action", "bg": "color.canvas", "kind": "ui" },
        { "fg": "color.focus", "bg": "color.canvas", "kind": "ui" }
      ]
    }
  }
}
